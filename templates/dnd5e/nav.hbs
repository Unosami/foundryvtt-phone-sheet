<nav class="ps-nav tabs">
  {{#each tabs}}
  <button type="button" class="{{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}">
    <i class="{{icon}}"></i><span>{{localize label}}</span>
  </button>
  {{/each}}
  <button type="button" data-action="openChat"><i class="fa-solid fa-comments"></i><span>{{localize "PHONESHEET.Chat"}}</span></button>
  <button type="button" data-action="openMenu"><i class="fa-solid fa-ellipsis"></i><span>{{localize "PHONESHEET.More"}}</span></button>
</nav>
