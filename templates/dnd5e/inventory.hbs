<section class="tab ps-scroll ps-has-filter {{tab.cssClass}}" data-group="primary" data-tab="inventory">
  {{> "modules/phone-sheet/templates/dnd5e/filterbar.hbs"}}

  <div class="ps-currency">
    {{#each currency}}
    <label class="ps-coin">
      <img src="{{icon}}" alt="">
      <input type="number" inputmode="numeric" min="0" name="{{name}}" value="{{value}}" aria-label="{{abbr}}">
      <small>{{abbr}}</small>
    </label>
    {{/each}}
  </div>

  {{> "modules/phone-sheet/templates/dnd5e/encumbrance.hbs"}}

  {{#each sections}}
  <div class="ps-group {{#if collapsed}}collapsed{{/if}}" data-filter-group>
    <button type="button" class="ps-heading ps-section-heading" data-action="toggleGroup" data-id="inventory.{{id}}">
      {{#if img}}<img src="{{img}}" alt="">{{/if}}{{localize label}}<span class="ps-count">{{rows.length}}</span>
      {{#if capacity}}<span class="ps-capacity">{{capacity}}</span>{{/if}}
      <i class="fa-solid fa-chevron-down"></i>
    </button>
    <ul class="ps-list">
      {{#each rows}}
      <li class="ps-item {{#if expanded}}expanded{{/if}}" data-key="{{key}}" data-item-id="{{itemId}}"
          data-search="{{search}}" data-tags="{{tags}}" data-name="{{name}}" data-weight="{{sortWeight}}" data-combat="{{sortCombat}}" data-order="{{@index}}">
        <button type="button" class="ps-row" data-action="toggleInfo">
          <img src="{{img}}" alt="">
          <span class="ps-label">
            {{name}}
            {{#if details}}<small class="ps-details">{{details}}</small>{{/if}}
          </span>
          {{#if equipped}}<i class="ps-flag fa-solid fa-shield-halved" data-tooltip="{{localize "PHONESHEET.Equipped"}}" aria-label="{{localize "PHONESHEET.Equipped"}}" role="img"></i>{{/if}}
          {{#with attunementFlag}}
          <i class="ps-flag ps-attunement {{state}} {{icon}}" data-tooltip="{{localize label}}" aria-label="{{localize label}}"
             role="img"></i>
          {{/with}}
          {{#if (ne quantity 1)}}<span class="ps-uses">×{{quantity}}</span>{{/if}}
        </button>
        {{#if expanded}}
        <div class="ps-item-panel">
          <div class="ps-item-controls">
            <div class="ps-qty">
              <button type="button" data-action="adjustQuantity" data-delta="-1" aria-label="−1"><i class="fa-solid fa-minus"></i></button>
              <span>{{quantity}}</span>
              <button type="button" data-action="adjustQuantity" data-delta="1" aria-label="+1"><i class="fa-solid fa-plus"></i></button>
            </div>
            {{#if canEquip}}
            <button type="button" class="{{#if equipped}}active{{/if}}" data-action="toggleEquipped">
              <i class="fa-solid fa-shield-halved"></i> {{localize (ifThen equipped "PHONESHEET.Unequip" "PHONESHEET.Equip")}}
            </button>
            {{/if}}
            {{#if attunement}}
            <button type="button" class="{{#if attuned}}active{{/if}}" data-action="toggleAttuned">
              <i class="fa-solid fa-sun"></i> {{localize (ifThen attuned "PHONESHEET.Unattune" "PHONESHEET.Attune")}}
            </button>
            {{/if}}
            {{#each activities}}
            <button type="button" class="ps-use" data-action="useActivity" data-activity-id="{{id}}">
              <i class="fa-solid fa-hand-sparkles"></i> {{name}}
            </button>
            {{/each}}
          </div>
          {{#if description}}<div class="ps-description">{{{description}}}</div>{{/if}}
        </div>
        {{/if}}
      </li>
      {{else}}
      <li class="ps-empty-row">{{localize "PHONESHEET.Inventory.Empty"}}</li>
      {{/each}}
    </ul>
  </div>
  {{/each}}
  <ul class="ps-flag-key">
    <li><i class="ps-flag fa-solid fa-shield-halved"></i>{{localize "PHONESHEET.Equipped"}}</li>
    <li><i class="ps-flag ps-attunement attuned fa-solid fa-sun"></i>{{localize "PHONESHEET.Attunement.Attuned"}}</li>
    <li><i class="ps-flag ps-attunement required fa-regular fa-sun"></i>{{localize "PHONESHEET.Key.Required"}}</li>
    <li><i class="ps-flag ps-attunement none fa-solid fa-sparkles"></i>{{localize "PHONESHEET.Key.None"}}</li>
  </ul>
  <p class="ps-empty ps-no-match" hidden>{{localize "PHONESHEET.NoMatches"}}</p>
</section>
